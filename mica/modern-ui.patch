+export function getSystemBackdrop(hwnd: number): number | null {
+  const DWMWA_SYSTEMBACKDROP_TYPE = 38;
+  const buf = new Int32Array(1);
+  const hr = dwmapi.symbols.DwmGetWindowAttribute(hwnd, DWMWA_SYSTEMBACKDROP_TYPE, ptr(buf), buf.byteLength);
+  return hr < 0 ? null : buf[0]!;
+}
