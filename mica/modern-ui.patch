 //--- double-buffer / deferred window positioning
 
+static const WCHAR* kMicaEnabled = L"Sumatra.Mica.Enabled";
+static const WCHAR* kMicaBg1 = L"Sumatra.Mica.Background1";
+static const WCHAR* kMicaBg2 = L"Sumatra.Mica.Background2";
+
+void MicaSetEnabled(HWND hwnd, bool enabled) {
+    if (enabled) {
+        SetPropW(hwnd, kMicaEnabled, (HANDLE)1);
+    } else {
+        RemovePropW(hwnd, kMicaEnabled);
+    }
+}
+
+bool MicaIsEnabled(HWND hwnd) {
+    return hwnd && GetPropW(GetAncestor(hwnd, GA_ROOT), kMicaEnabled);
+}
+
+static u32 MicaDibColor(Color c) {
+    return ((c & 0xff) << 16) | (c & 0xff00) | ((c >> 16) & 0xff);
+}
+
+void MicaSetBackgrounds(HWND hwnd, Color first, Color second) {
+    SetPropW(hwnd, kMicaBg1, (HANDLE)(UINT_PTR)(MicaDibColor(first) + 1));
+    SetPropW(hwnd, kMicaBg2, (HANDLE)(UINT_PTR)(MicaDibColor(second) + 1));
+}
+
+// GDI destroys alpha. Composite a copy so partial repaints keep their original
+// RGB backing store. Page rectangles are excluded before any background removal.
+bool MicaBlt(HWND hwnd, HDC target, HDC source, Rect area, const Rect* opaque, int opaqueCount) {
+    if (!MicaIsEnabled(hwnd) || area.IsEmpty()) {
+        return false;
+    }
+    HBITMAP bitmap = CreateMemoryBitmap(area.Size());
+    HDC dc = CreateCompatibleDC(target);
+    if (!bitmap || !dc) {
+        DeleteObject(bitmap);
+        DeleteDC(dc);
+        return false;
+    }
+    HGDIOBJ previous = SelectObject(dc, bitmap);
+    defer {
+        SelectObject(dc, previous);
+        DeleteObject(bitmap);
+        DeleteDC(dc);
+    };
+    SetLayout(dc, 0);
+    if (!BitBlt(dc, 0, 0, area.dx, area.dy, source, 0, 0, SRCCOPY)) {
+        return false;
+    }
+    GdiFlush();
+    DIBSECTION dib{};
+    if (!GetObjectW(bitmap, sizeof(dib), &dib) || !dib.dsBm.bmBits) {
+        return false;
+    }
+    auto* pixels = (u32*)dib.dsBm.bmBits;
+    int stride = dib.dsBm.bmWidthBytes / sizeof(u32);
+    for (int y = 0; y < area.dy; y++) {
+        for (int x = 0; x < area.dx; x++) {
+            pixels[y * stride + x] |= 0xff000000;
+        }
+    }
+
+    HRGN background = CreateRectRgn(0, 0, area.dx, area.dy);
+    defer {
+        DeleteObject(background);
+    };
+    for (int i = 0; i < opaqueCount; i++) {
+        Rect r = opaque[i].Intersect(area);
+        HRGN page = CreateRectRgn(r.x - area.x, r.y - area.y, r.Right() - area.x, r.Bottom() - area.y);
+        CombineRgn(background, background, page, RGN_DIFF);
+        DeleteObject(page);
+    }
+    DWORD bytes = GetRegionData(background, 0, nullptr);
+    if (!bytes) {
+        return false;
+    }
+    auto* region = (RGNDATA*)malloc(bytes);
+    if (!region) {
+        return false;
+    }
+    defer {
+        free(region);
+    };
+    if (!GetRegionData(background, bytes, region)) {
+        return false;
+    }
+    HWND root = GetAncestor(hwnd, GA_ROOT);
+    u32 colors[] = {
+        (u32)(UINT_PTR)GetPropW(root, kMicaBg1) - 1,
+        (u32)(UINT_PTR)GetPropW(root, kMicaBg2) - 1,
+        (u32)(UINT_PTR)GetPropW(hwnd, kMicaBg1) - 1,
+        (u32)(UINT_PTR)GetPropW(hwnd, kMicaBg2) - 1,
+    };
+    auto* rects = (RECT*)region->Buffer;
+    for (DWORD i = 0; i < region->rdh.nCount; i++) {
+        RECT r = rects[i];
+        for (int y = r.top; y < r.bottom; y++) {
+            for (int x = r.left; x < r.right; x++) {
+                u32& pixel = pixels[y * stride + x];
+                u32 rgb = pixel & 0xffffff;
+                if (rgb == colors[0] || rgb == colors[1] || rgb == colors[2] || rgb == colors[3]) {
+                    pixel = 0;
+                }
+            }
+        }
+    }
+    return BitBlt(target, area.x, area.y, area.dx, area.dy, dc, 0, 0, SRCCOPY) != FALSE;
+}
